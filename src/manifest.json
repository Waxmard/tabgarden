{
  "manifest_version": 3,
  "name": "tabgarden",
  "version": "0.2.0",
  "description": "Group the tabs in your window by topic in one keystroke, and close the loose tabs after the one you're on.",
  "minimum_chrome_version": "138",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["tabGroups", "sidePanel", "storage", "idle"],
  "optional_permissions": ["tabs"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "tabgarden"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "commands": {
    "clear-down": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Close loose tabs after this one"
    },
    "group-ungrouped": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "AI-group ungrouped tabs"
    },
    "smart-clear": {
      "suggested_key": {
        "default": "Alt+Shift+J"
      },
      "description": "Close loose tabs from sites you rarely use"
    },
    "ungroup-all": {
      "suggested_key": {
        "default": "Alt+Shift+U"
      },
      "description": "Ungroup every tab in the window"
    }
  }
}
