{
  "manifest_version": 3,
  "name": "tabgarden",
  "version": "0.2.0",
  "description": "AI tab grouping and clear-from-here-down, Arc style.",
  "minimum_chrome_version": "138",
  "permissions": ["storage", "tabs", "tabGroups"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "tabgarden"
  },
  "commands": {
    "clear-down": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Close loose tabs below this one"
    },
    "group-ungrouped": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "AI-group ungrouped tabs"
    },
    "regroup-all": {
      "description": "AI-regroup every tab in the window"
    },
    "ungroup-all": {
      "description": "Ungroup every tab in the window"
    }
  }
}
